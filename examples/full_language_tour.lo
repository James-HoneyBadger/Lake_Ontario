110 FACT_CHECK hypotenuse_squared = raw_sqrt POWER_TO_THE_PEOPLE 2
120 BROADCAST_CBC "Peer-Reviewed Hypotenuse Calculation (3^2 + 4^2 = 5^2): " + hypotenuse_squared

