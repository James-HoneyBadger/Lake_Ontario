180 FACT_CHECK organized_union = UNIONIZE(workers)
190 BROADCAST_CBC "Organized Bargaining Unit: " + organized_union
200 BADGER_BITE HONEY_BADGER_STRIKE("Demanding 100% Paid Family Leave & Single-Payer Health & Dental")

210 BROADCAST_CBC "=== 3. Pro-Diversity & Inclusive Community Celebration ==="
