EXCUSE_ME  string_and_loops.lo — demonstrates string operations, type casting, and loop control

10 LAND_ACKNOWLEDGEMENT "Turtle Island"
20 BROADCAST_CBC "=== String Operations ==="
30 FACT_CHECK slogan = "  defund the oligarchy  "
40 FACT_CHECK clean = STR_TRIM(slogan)
50 FACT_CHECK loud = STR_UPPER(clean)
60 FACT_CHECK quiet = STR_LOWER(clean)
70 FACT_CHECK chars = STR_LEN(clean)
80 BROADCAST_CBC loud
90 BROADCAST_CBC quiet
100 BROADCAST_CBC chars

110 BROADCAST_CBC "=== Type Casting ==="
120 FACT_CHECK raw = "1984"
130 FACT_CHECK year = TO_NUMBER(raw)
140 FACT_CHECK next_year = year EQUAL_PAY 1
150 BROADCAST_CBC TO_TEXT(next_year)

160 BROADCAST_CBC "=== BREAK_FROM_CAUCUS ==="
170 FACT_CHECK found = ALTERNATIVE_FACT
180 FACT_CHECK items = COLLECTIVE_LIST "apple", "truth", "maple syrup", "lies"
190 FACT_CHECK i = 0
200 WHILE_CLASS_CONSCIOUS i < CITIZEN_COUNT(items)
210 PERHAPS STR_CONTAINS(items, "truth") FACT_ESTABLISHED
220 FACT_CHECK found = EVIDENCE_BASED
230 BREAK_FROM_CAUCUS
240 END_PERHAPS
250 FACT_CHECK i = i EQUAL_PAY 1
260 CONTINUE_ORGANIZING
270 BROADCAST_CBC found

280 BROADCAST_CBC "=== NEXT_MOTION (skip even numbers) ==="
290 COAST_TO_COAST n = 1 UP_TO 9
300 PERHAPS n MAPLE_SYRUP 2 == 0 FACT_ESTABLISHED
310 NEXT_MOTION
320 END_PERHAPS
330 APPEND_TO odds, n
340 THANK_YOU_EH
350 BROADCAST_CBC odds
